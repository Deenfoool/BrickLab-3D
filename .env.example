# Host-side port and interface. Keep loopback behind an HTTPS reverse proxy.
BRICKLAB_BIND=127.0.0.1
BRICKLAB_PORT=8080
# Required before Docker Compose starts. Generate a strong random password.
# Example command: openssl rand -hex 32
BRICKLAB_DB_PASSWORD=
# Separate password for the restricted runtime role (openssl rand -hex 32)
BRICKLAB_APP_PASSWORD=
# Set to the exact HTTPS origin on production, without trailing slash.
PUBLIC_ORIGIN=http://localhost:8080
# Enable only for controlled testing until email verification and abuse controls are ready.
BRICKLAB_REGISTRATION_ENABLED=false

# Optional: exact socket peer of a trusted reverse proxy that overwrites X-Real-IP.
# Leave empty for direct connections; do not expose the backend or trust an entire subnet.
BRICKLAB_TRUSTED_PROXY_IP=
